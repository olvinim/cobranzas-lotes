# Credenciales de Supabase (proyecto SEPARADO de ResidencialPay).
# Copiar este archivo a .env.local y rellenar con los valores reales.
# .env.local está en .gitignore y NUNCA se commitea.

# URL pública del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (Settings → API → Project API keys → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — BYPASEA RLS, SOLO servidor, nunca exponer al navegador
# (Settings → API → Project API keys → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=
